HOST=127.0.0.1
PORT=4320
PUBLIC_URL=http://localhost:4320
DATABASE_PATH=./data/maildesk.sqlite
# Generate with npm run setup. Never commit this key; back it up securely.
ENCRYPTION_KEY=
# Disable after creating your companies or use an invite-only deployment.
ALLOW_SIGNUP=true
NODE_ENV=development
# Optional social login. Each provider appears only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
