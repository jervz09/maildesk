# Add these to Vercel's Production environment. Never commit real values.
# Use Connect > Transaction pooler (port 6543), with a URL-encoded DB password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
PUBLIC_URL=https://YOUR_PROJECT_NAME.vercel.app
ENCRYPTION_KEY=
WORKER_SECRET=
ALLOW_SIGNUP=true
NODE_ENV=production
# Optional PEM CA certificate if required by your database endpoint.
# DATABASE_CA_CERT=
# Social login credentials (server-only). See OAUTH.md for callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
